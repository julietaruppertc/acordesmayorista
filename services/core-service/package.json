    "node": ">=24"
  },
  "dependencies": {
    "dotenv": "^18.0.0",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "vitest": "^4.0.0"
  }
