{
  "name": "core-service",
  "version": "1.0.0",
  "private": true,
  "description": "Servicio Core de Acordes Mayorista: catálogo, stock, pedidos, pagos y outbox.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
