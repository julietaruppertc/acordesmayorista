CORE_PORT=4002
DATABASE_URL=<postgresql-connection-string>
DATABASE_SSL=false
RESERVATION_TTL_MINUTES=5
RESERVATION_JOB_INTERVAL_SECONDS=30
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_MAX_ATTEMPTS=3
PAYMENT_WEBHOOK_SECRET=<private-random-value-min-32-chars>
TRUST_GATEWAY_HEADERS=true
NODE_ENV=development

# MVP: admin resuelve pedidos mediante pago simulado; deshabilitado por defecto.
ENABLE_PAYMENT_SIMULATOR=false
