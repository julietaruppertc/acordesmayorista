CORE_PORT=4002
DATABASE_URL=<postgresql-connection-string>
DATABASE_SSL=false
RESERVATION_TTL_MINUTES=5
RESERVATION_JOB_INTERVAL_SECONDS=30
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_LOCK_TIMEOUT_SECONDS=300
PAYMENT_WEBHOOK_SECRET=<private-random-value-min-32-chars>
TRUST_GATEWAY_HEADERS=true
NODE_ENV=development

# MVP: admin resuelve pedidos mediante pago simulado; deshabilitado por defecto.
ENABLE_PAYMENT_SIMULATOR=false

# Notarización opcional de pedidos de alto valor. Los secretos reales solo van en .env privado.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=
RELAYER_PRIVATE_KEY=
ATTESTATION_CONTRACT_ADDRESS=
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_DEPLOYMENT_BLOCK=0
BLOCKCHAIN_EXPLORER_URL=https://sepolia.etherscan.io/tx/
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_TX_TIMEOUT_SECONDS=180
HIGH_VALUE_THRESHOLD_ARS=2000000
