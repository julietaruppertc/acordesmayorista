# Gateway
GATEWAY_PORT=8000
CLIENT_ORIGIN=http://localhost:5173

# Auth Service
AUTH_PORT=4001
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/acordes_auth
JWT_EXPIRES_IN=15m

# Core Service
CORE_PORT=4002
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/acordes_core

# Claves Asimétricas (o paths)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"